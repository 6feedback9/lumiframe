{
  "name": "@lumiframe/api",
  "version": "0.1.0",
  "private": true,
  "description": "Public API + TryOnWorker. See ARCHITECTURE.md §7.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/worker/run.ts",
    "start": "tsx src/server.ts",
    "worker:start": "tsx src/worker/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "create-admin": "node scripts/createPlatformAdmin.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@lumiframe/database": "workspace:*",
    "@lumiframe/provider-mock": "workspace:*",
    "@lumiframe/queue": "workspace:*",
    "@lumiframe/storage": "workspace:*",
    "@lumiframe/tryon": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
