# ============================================================
# Lumi Frame — environment variables (all apps read a subset of this)
# ============================================================

# ── Database (Supabase Postgres, accessed via Prisma) ────────
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ── Object storage (Supabase Storage, S3-compatible) ─────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET_CUSTOMER_PHOTOS="customer-photos"
STORAGE_BUCKET_TRYON_RESULTS="tryon-results"
STORAGE_BUCKET_PRODUCT_ASSETS="product-assets"
# Only used when SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are absent — signs
# the local filesystem storage adapter's URLs for dev/CI (packages/storage).
STORAGE_SIGNING_SECRET="dev-only-change-me"

# ── Queue (Redis, e.g. Upstash) ───────────────────────────────
REDIS_URL="rediss://default:password@xxxx.upstash.io:6379"

# ── AI try-on provider ────────────────────────────────────────
# mock   = MockTryOnProvider (default for dev/CI, no external API calls,
#          returns a labeled placeholder image)
# gemini = GeminiTryOnProvider (packages/providers/real) — real generation
#          via Google Gemini's image-editing model. Requires GEMINI_API_KEY.
AI_PROVIDER="mock"
# Get a key at https://aistudio.google.com/apikey. Only read when
# AI_PROVIDER=gemini.
GEMINI_API_KEY=""
# Optional — defaults to "gemini-3.1-flash-image-preview" if unset. Override
# if Google ships a newer image model later (packages/providers/real/src/index.ts).
GEMINI_IMAGE_MODEL=""

# ── Privacy / retention (see ARCHITECTURE.md #8) ──────────────
CUSTOMER_IMAGE_RETENTION_HOURS=24
TRYON_RESULT_RETENTION_HOURS=720

# ── Attribution (see ARCHITECTURE.md #10) ─────────────────────
TRYON_ATTRIBUTION_WINDOW_HOURS=72

# ── Auth / security ────────────────────────────────────────────
JWT_SECRET=""
SESSION_COOKIE_SECRET=""

# ── App URLs ───────────────────────────────────────────────────
API_BASE_URL="http://localhost:4000"
DASHBOARD_BASE_URL="http://localhost:3000"
DEMO_STORE_BASE_URL="http://localhost:3100"

PORT=4000
NODE_ENV="development"
