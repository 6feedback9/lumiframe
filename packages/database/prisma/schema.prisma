// ============================================================
// Lumi Frame — Prisma schema
// See ARCHITECTURE.md §4 for the rationale behind each entity.
//
// Design rules encoded here:
//  - Every tenant-scoped table carries `tenantId` directly (not just via a
//    join) so every query can filter on it without an extra hop.
//  - There is no merchant Product/catalog table. Product identity is just
//    `externalProductId` + a point-in-time snapshot on TryOnSession.
//  - Money is Decimal, never Float.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlatformType {
  SHOPIFY
  WOOCOMMERCE
  GENERIC
  CUSTOM
}

enum StoreStatus {
  PENDING // created, integration not finished
  ACTIVE
  SUSPENDED
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
}

// Mirrors ARCHITECTURE.md §5 (TryOnSession lifecycle). TryOnGeneration
// reuses the same enum for its own, per-attempt status.
enum TryOnStatus {
  CREATED
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

// The shopper's own reaction to their try-on result (product ask: let the
// customer like/dislike a try-on, and give the merchant/platform owner a
// feedback view). Set once a result exists — never before COMPLETED.
enum TryOnFeedback {
  LIKE
  DISLIKE
}

// Mirrors ARCHITECTURE.md §9 (Events), plus the two attribution-specific
// event kinds named explicitly in the product spec (§26): TRYON_ADD_TO_CART
// and TRYON_ORDER are recorded in addition to the generic ADD_TO_CART /
// ORDER_COMPLETED so attribution queries don't have to infer "was this
// cart/order tied to a try-on" from a join.
enum EventType {
  WIDGET_OPENED
  PHOTO_SELECTED
  TRYON_STARTED
  TRYON_COMPLETED
  TRYON_FAILED
  RESULT_VIEWED
  TRY_ANOTHER
  BACK_TO_PRODUCT
  ADD_TO_CART
  TRYON_ADD_TO_CART
  CHECKOUT_STARTED
  ORDER_COMPLETED
  TRYON_ORDER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum AttributionModel {
  LAST_TOUCH
}

enum PlanKey {
  // A real Plan row, not a special "no plan + topUpCredits" state — see
  // Tenant.planId below. $0/mo, monthlyLimit 5, admin-grant only (never
  // shown in the merchant-facing billing route's own plan list — see
  // routes/billing.ts — only in the admin's, routes/admin.ts). Lifetime,
  // not a monthly quota that would otherwise reset forever free — see
  // checkPlanEntitlement's isTrialPlan handling and the worker's
  // auto-downgrade back to planId=null once it's used up.
  TEST
  STARTER
  GROWTH
  PRO
}

// ────────────────────────────────────────────────────────────
// Tenant / auth
// ────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Billing (ARCHITECTURE.md §13 addendum) ──────────────────────────
  // Null planId = no plan assigned yet (blocks try-on creation — see
  // apps/api/src/routes/tryons.ts). topUpCredits is a persistent balance,
  // not month-scoped: consumed one-for-one once the current calendar
  // month's plan.monthlyLimit is used up, and never expires on its own.
  planId       String?
  topUpCredits Int     @default(0)
  // Set by the merchant's dashboard ("request a plan change / more
  // credits" — payment is handled manually for now, see DEPLOYMENT.md) and
  // cleared automatically the next time an admin changes this tenant's
  // plan or adds credits.
  planRequestNote String?
  planRequestedAt DateTime?
  // Every new tenant is assigned the TEST plan (see PlanKey) at
  // registration, so this used to be "was a trial ever granted" back
  // when trial was a separate topUpCredits balance rather than a real
  // plan — kept only as a "when did this tenant's trial start" record
  // for the admin UI now (routes/admin.ts still updates it whenever the
  // TEST plan is (re-)assigned). Not itself checked by any entitlement
  // logic anymore — planId being the TEST plan's id is.
  trialGrantedAt DateTime?

  plan          Plan?          @relation(fields: [planId], references: [id])
  users         User[]
  stores        Store[]
  auditLogs     AuditLog[]
  tryOnSessions TryOnSession[]
  events        Event[]

  @@map("tenants")
}

// Seeded once via migration (packages/database/prisma/migrations) — see
// DEPLOYMENT.md for the exact numbers and how they were derived from
// Gemini's per-image cost. Not exposed as an admin-editable CRUD screen
// yet; adjust via a SQL UPDATE the same way the platform-admin account
// was created, if the numbers ever need to change.
model Plan {
  id                String   @id @default(cuid())
  key               PlanKey  @unique
  name              String
  monthlyLimit      Int
  priceUsd          Decimal  @db.Decimal(10, 2)
  topUpPackSize     Int
  topUpPackPriceUsd Decimal  @db.Decimal(10, 2)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @unique
  passwordHash String
  name         String?
  role         UserRole  @default(OWNER)
  // A platform-owner account (you, the Lumi Frame operator), not a
  // merchant. Bootstrapped by an operator-run script (apps/api/scripts/
  // createPlatformAdmin.mjs) for the very first admin — there is
  // deliberately no *public* HTTP path that can mint one. Once at least
  // one platform admin exists, apps/api/src/routes/admin.ts's
  // authenticateAdmin-gated /api/v1/admin/team lets an existing admin add
  // more (an informed, explicit product decision — see that route's
  // comment). Still belongs to a Tenant row (the reserved
  // "lumiframe-platform" tenant) purely to satisfy the existing
  // User->Tenant relation; it does not mean this account is scoped to
  // that tenant's data the way a merchant is.
  isPlatformAdmin Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

// ────────────────────────────────────────────────────────────
// Store / integration
// ────────────────────────────────────────────────────────────

model Store {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  storeUrl     String
  platformType PlatformType @default(GENERIC)
  status       StoreStatus  @default(PENDING)

  // ARCHITECTURE.md §11 — which origins this store may submit
  // `productImageUrl` from. Required non-empty before status can be ACTIVE.
  allowedDomains String[]

  // White-label knobs (product spec §54): logo, primaryColor, buttonText,
  // language, showPoweredBy. Kept as JSON since it's presentation-only and
  // grows without needing a migration.
  widgetConfig Json @default("{}")

  // Per-store overrides of the global env defaults; null = inherit env var.
  customerImageRetentionHours Int?
  tryonResultRetentionHours   Int?
  attributionWindowHours      Int?

  // Anti-abuse (product ask: a merchant can cap how many try-ons the same
  // shopper gets, so one visitor can't hammer the store's monthly quota).
  // null = unlimited. Enforced by IP in apps/api/src/routes/tryons.ts —
  // visitorId alone isn't enough since it's client-generated and trivially
  // reset by clearing storage.
  maxTryOnsPerVisitor Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  integration   Integration?
  tryOnSessions TryOnSession[]
  events        Event[]
  orders        Order[]
  usageRecords  UsageRecord[]

  @@index([tenantId])
  @@map("stores")
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  storeId    String
  label      String
  // Only a salted hash is ever stored; the raw key is shown once at creation.
  hashedKey  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([storeId])
  @@map("api_keys")
}

model Integration {
  id           String            @id @default(cuid())
  storeId      String            @unique
  platformType PlatformType
  status       IntegrationStatus @default(NOT_CONFIGURED)

  // Platform-specific config: Shopify shop domain, WooCommerce site URL,
  // or for `generic` — the merchant-configured DOM selectors described in
  // ARCHITECTURE.md §8 step 5 (productIdSelector, productTitleSelector,
  // productImageSelector, priceSelector, skuSelector, addToCartSelector).
  config Json @default("{}")

  // OAuth/webhook credentials, encrypted at rest by the application layer
  // before being written here. Never returned by any API response.
  encryptedCredentials String?

  installedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

// ────────────────────────────────────────────────────────────
// Try-on core
// ────────────────────────────────────────────────────────────

// One row per "customer opened Try-On for this product". Holds the product
// SNAPSHOT (never a catalog reference) and the attribution context captured
// at open time. See ARCHITECTURE.md §4 and §10.
model TryOnSession {
  id       String @id @default(cuid())
  tenantId String
  storeId  String

  // ── Product snapshot (source of truth = merchant's page, at this moment) ──
  externalProductId String
  productTitle       String?
  productUrl         String?
  productImageUrl    String
  sku                String?
  price              Decimal? @db.Decimal(12, 2)
  currency           String?

  // ── Visitor / session identity (anonymous, no customer account) ──
  visitorId       String
  browserSessionId String?
  // Captured from the request at creation (behind Render's proxy — see
  // app.ts's trustProxy). Used to enforce Store.maxTryOnsPerVisitor: unlike
  // visitorId, it can't be reset just by clearing browser storage.
  visitorIp        String?

  // ── Attribution context, captured once and never overwritten ──
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  gclid       String?
  fbclid      String?
  ttclid      String?
  referrer    String?
  device      String?

  // Denormalized convenience: mirrors the latest TryOnGeneration's status,
  // kept in sync by the worker. Source of truth is still TryOnGeneration.
  status TryOnStatus @default(CREATED)

  // The shopper's like/dislike on their own result (public, unauthenticated
  // POST from the widget — see apps/api/src/routes/tryons.ts's /feedback
  // route). Null until they tap one.
  feedback   TryOnFeedback?
  feedbackAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  generations TryOnGeneration[]
  events      Event[]
  attribution Attribution?

  @@index([tenantId, storeId, createdAt(sort: Desc)])
  @@index([storeId, externalProductId])
  @@index([visitorId])
  @@index([tenantId, feedback])
  @@index([storeId, visitorIp])
  @@map("tryon_sessions")
}

// One row per actual AI generation attempt within a session. "Try another
// photo" appends a new row here rather than creating a new TryOnSession or
// overwriting the previous attempt (ARCHITECTURE.md §5).
model TryOnGeneration {
  id             String @id @default(cuid())
  tryOnSessionId String
  tenantId       String
  storeId        String

  // Private-storage object keys, never public URLs. Resolved to signed
  // URLs by packages/storage at read time.
  customerImageKey      String?
  customerImageMimeType String?
  // Processed product/eyewear asset used for this generation. Phase 1
  // reprocesses on every generation (no content-hash cache yet — that
  // lands with the real ProductImageProcessor in Phase 2).
  productAssetKey       String?
  productAssetMimeType  String?
  resultImageKey        String?
  resultImageMimeType   String?

  status TryOnStatus @default(CREATED)

  provider           String? // e.g. "mock", set once a job is enqueued
  providerJobId       String?
  generationDurationMs Int?
  errorCode           String?
  errorMessage         String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  session TryOnSession @relation(fields: [tryOnSessionId], references: [id], onDelete: Cascade)
  usage   UsageRecord?

  @@index([tryOnSessionId])
  @@index([tenantId, storeId, status])
  @@index([providerJobId])
  @@map("tryon_generations")
}

// Append-only funnel log, ARCHITECTURE.md §9. Deliberately flat so
// dashboard aggregation queries stay cheap.
model Event {
  id       String    @id @default(cuid())
  tenantId String
  storeId  String
  type     EventType

  tryOnSessionId    String?
  externalProductId String?
  visitorId         String
  browserSessionId  String?

  // Structured UTM lives on TryOnSession (the attribution source of truth);
  // here it's a lightweight copy for ad-hoc funnel analysis without a join.
  utm Json?

  referrer String?
  device   String?

  // Event-specific payload, e.g. { errorCode } for TRYON_FAILED,
  // { cartToken } for ADD_TO_CART, { orderId } for ORDER_COMPLETED.
  metadata Json?

  occurredAt DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store   Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session TryOnSession? @relation(fields: [tryOnSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, occurredAt(sort: Desc)])
  @@index([tryOnSessionId])
  @@index([type, occurredAt(sort: Desc)])
  @@map("events")
}

// ────────────────────────────────────────────────────────────
// Orders / attribution
// ────────────────────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  tenantId         String
  storeId          String
  externalOrderId  String // the merchant platform's own order number/id
  visitorId        String?
  currency         String
  totalAmount      Decimal     @db.Decimal(12, 2)
  status           OrderStatus @default(PAID)
  placedAt         DateTime
  createdAt        DateTime    @default(now())

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  attribution Attribution?

  @@unique([storeId, externalOrderId])
  @@index([tenantId, storeId, placedAt(sort: Desc)])
  @@index([visitorId])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  externalProductId String
  title             String?
  quantity          Int     @default(1)
  unitPrice         Decimal @db.Decimal(12, 2)
  totalPrice        Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([externalProductId])
  @@map("order_items")
}

// Links one Order to the TryOnSession that (per the attribution model and
// window — ARCHITECTURE.md §10) is credited for it. At most one
// Attribution per Order.
model Attribution {
  id             String           @id @default(cuid())
  tenantId       String
  storeId        String
  orderId        String           @unique
  tryOnSessionId String           @unique
  model          AttributionModel @default(LAST_TOUCH)
  windowHours    Int
  minutesBetween Int // time between try-on session creation and order placedAt
  createdAt      DateTime         @default(now())

  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session TryOnSession @relation(fields: [tryOnSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeId])
  @@map("attributions")
}

// ────────────────────────────────────────────────────────────
// Billing
// ────────────────────────────────────────────────────────────

// One row per completed try-on generation. Billing/pricing logic reads
// this; no price is hardcoded here (product spec §55).
model UsageRecord {
  id                String   @id @default(cuid())
  tenantId          String
  storeId           String
  tryOnGenerationId String   @unique
  provider          String
  units             Int      @default(1)
  providerCostCents Int? // raw cost reported by the provider, if any
  createdAt         DateTime @default(now())

  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  generation TryOnGeneration @relation(fields: [tryOnGenerationId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeId, createdAt])
  @@map("usage_records")
}

// ────────────────────────────────────────────────────────────
// Audit
// ────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  actorUserId  String?
  action       String // e.g. "api_key.created", "integration.updated"
  targetType   String?
  targetId     String?
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
